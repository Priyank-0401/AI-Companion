# Frontend Environment Configuration (Example)
VITE_API_BASE_URL=http://localhost:3001/api
VITE_APP_TITLE=AI Companion
VITE_APP_VERSION=1.0.0

# Azure TTS Configuration
VITE_AZURE_TTS_KEY=your_azure_tts_api_key_here
VITE_AZURE_TTS_REGION=eastus

# Firebase Configuration
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# App Check Configuration
# Enable App Check in development (set to 'true' to enable in development)
VITE_ENABLE_APP_CHECK=false
# ReCAPTCHA v3 Site Key (get from Firebase Console > Project Settings > App Check)
VITE_RECAPTCHA_V3_SITE_KEY=your_recaptcha_v3_site_key
# Debug token for development (set to true or a specific token)
VITE_APP_CHECK_DEBUG_TOKEN=your_debug_token_or_true

# WebSocket Configuration
VITE_WEBSOCKET_URL=ws://localhost:3001/ws
# In production, use wss://your-backend-domain.com/ws
