# ====================================
# Environment Configuration
# ====================================
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# ====================================
# Application Settings
# ====================================
APP_NAME=AI-Companion
APP_VERSION=1.0.0
APP_SECRET=your_app_secret_key_here
API_PREFIX=/api

# ====================================
# Firebase Admin SDK Configuration
# ====================================
# Get these values from Firebase Console > Project Settings > Service accounts
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://your-project-id.firebaseio.com

# ====================================
# JWT Configuration
# ====================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES=7

# ====================================
# Database Configuration
# ====================================
# MongoDB (if using MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai-companion
MONGODB_DEBUG=true

# Redis (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ====================================
# Ollama Configuration
# ====================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama2
OLLAMA_TIMEOUT=30000

# ====================================
# CORS Configuration
# ====================================
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100            # Max requests per window per IP

# ====================================
# Logging
# ====================================
LOG_LEVEL=info
LOG_DIR=./logs
LOG_FILE=app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ====================================
# Email Configuration (for notifications)
# ====================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-email-password
EMAIL_FROM=AI Companion <noreply@aicompanion.com>

# ====================================
# File Uploads
# ====================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ====================================
# Security Headers
# ====================================
SECURE_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self';
XSS_PROTECTION=1; mode=block
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ====================================
# Session Configuration
# ====================================
SESSION_SECRET=your_session_secret_here
SESSION_MAX_AGE=86400000  # 24 hours

# ====================================
# Feature Flags
# ====================================
FEATURE_MAINTENANCE_MODE=false
FEATURE_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_RATE_LIMITING=true

# ====================================
# Monitoring & Analytics
# ====================================
SENTRY_DSN=your-sentry-dsn
GOOGLE_ANALYTICS_ID=UA-XXXXX-Y

# ====================================
# External APIs
# ====================================
# Add any external API keys here
WEATHER_API_KEY=your-weather-api-key

# ====================================
# Development Overrides
# ====================================
if [ "$NODE_ENV" = "development" ]; then
  LOG_LEVEL=debug
  MONGODB_URI=mongodb://localhost:27017/ai-companion-dev
  CORS_ORIGIN=*
  RATE_LIMIT_MAX=1000
  JWT_SECRET=dev_secret_key_change_in_production
  SESSION_SECRET=dev_session_secret_change_in_production
fi

# ====================================
# Test Overrides
# ====================================
if [ "$NODE_ENV" = "test" ]; then
  PORT=3002
  MONGODB_URI=mongodb://localhost:27017/ai-companion-test
  LOG_LEVEL=error
  JWT_SECRET=test_secret_key
  SESSION_SECRET=test_session_secret
  FEATURE_RATE_LIMITING=false
fi
