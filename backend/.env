# ====================================
# JWT Configuration
# ====================================
JWT_SECRET=T9pL2%kQ8xZmN$jR4tY6wE1sD5gH3cF7vB9nJ0qW2eX5zP8rT4yU6iKv7L
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES=7


# Redis (for caching and rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ====================================
# Ollama Configuration
# ====================================
OLLAMA_API_URL=http://localhost:11434
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8B
OLLAMA_TIMEOUT=30000

# ====================================
# CORS Configuration
# ====================================
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,x-request-start,X-Request-Start,Accept,Accept-Encoding,Accept-Language,Cache-Control,Connection,DNT,Origin,Referer,User-Agent
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_EXPOSED_HEADERS=Content-Length,X-Foo,X-Bar,x-request-start

# ====================================
# Rate Limiting
# ====================================
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100           # Max requests per window per IP

# ====================================
# Logging
# ====================================
LOG_LEVEL=info
LOG_DIR=./logs
LOG_FILE=app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=7

# ====================================
# File Uploads
# ====================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5  # in MB
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ====================================
# Security Headers
# ====================================
SECURE_HEADERS=true
CONTENT_SECURITY_POLICY=default-src 'self'
XSS_PROTECTION=1; mode=block
X_FRAME_OPTIONS=SAMEORIGIN
X_CONTENT_TYPE_OPTIONS=nosniff
HSTS_ENABLED=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# ====================================
# Session Configuration
# ====================================
SESSION_SECRET=mN$jR4tY6wE1sD5gH3cF7vB9nJ0qW2eX5zP8rT4yU6iKv7L9p$k2#QxZ8m
SESSION_MAX_AGE=86400000  # 24 hours

# ====================================
# Feature Flags
# ====================================
FEATURE_MAINTENANCE_MODE=false
FEATURE_REGISTRATION=true
FEATURE_EMAIL_VERIFICATION=false
FEATURE_RATE_LIMITING=true