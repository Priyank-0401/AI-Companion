# Environment Configuration
NODE_ENV=development
PORT=3001

# Ollama Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Data Storage
DATA_DIR=./data

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Security
API_RATE_LIMIT=100
API_RATE_WINDOW=900000



# Firebase Admin SDK
FIREBASE_PROJECT_ID=ai-companion-agent
FIREBASE_PRIVATE_KEY_ID=b041c5d17a14837151e7bdf8a238d26548a56c2c
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@ai-companion-agent.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=113749328358254822397
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-fbsvc%40ai-companion-agent.iam.gserviceaccount.com
